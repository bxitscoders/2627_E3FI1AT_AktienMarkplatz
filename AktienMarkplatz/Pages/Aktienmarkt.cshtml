@page
@using Microsoft.AspNetCore.Authorization;
@model AktienMarkplatz.Pages.AktienmarktModel
@attribute [Authorize(Roles = "User")]
@{
    ViewData["Title"] = "Aktienmarkt";
}

<section class="suche">
    <form method="get" class="suche__form">
        <label for="symbol" class="visually-hidden">Ticker oder Firmenname</label>
        <input id="symbol"
               type="text"
               name="symbol"
               class="suche__eingabe"
               placeholder="Ticker oder Firmenname, z. B. Apple, SAP, ServiceNow"
               value="@Model.Symbol"
               autocomplete="off" />
        <button type="submit" class="suche__button">Suchen</button>
    </form>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Symbol))
{
    <section class="ergebnis" aria-live="polite">
        @if (Model.GefundeneAktie is null)
        {
            <p class="ergebnis__leer">
                Keine Aktie gefunden für „@Model.Symbol“. Versuch's mit dem Tickersymbol, z. B. AAPL.
            </p>
        }
        else
        {
            var aktie = Model.GefundeneAktie;

            <div class="ergebnis__kopf">
                <span class="ergebnis__ticker">@aktie.Symbol</span>
                <span class="ergebnis__meta">@aktie.Name</span>
            </div>

            <table class="tabelle">
                <thead>
                    <tr>
                        <th scope="col">Kurs</th>
                        <th scope="col">Heute</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@aktie.AktuellerKurs.ToString("0.00") $</td>
                        <td class="@aktie.VeraenderungCssKlasse()">@aktie.KursAenderung()</td>
                    </tr>
                </tbody>
            </table>

            @if (Model.Verlauf is not null)
            {
                <partial name="_Kursdiagramm" model="Model.Verlauf" />
            }
        }
    </section>
}

@* Die Beispielaktien nur ohne Suche zeigen, bei einer Suche nur das Ergebnis. *@
@if (string.IsNullOrWhiteSpace(Model.Symbol))
{
    <section class="top-aktien">
        <h2>Aktienprodukte</h2>

        <table class="tabelle">
            <thead>
                <tr>
                    <th scope="col">Wertpapier</th>
                    <th scope="col">Kurs</th>
                    <th scope="col">Heute</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var aktie in Model.Boerse.GroessteAktien())
                {
                    <tr>
                        <td>
                            <span class="wertpapier__ticker">@aktie.Symbol</span>
                            <span class="wertpapier__name">@aktie.Name</span>
                        </td>
                        <td>@aktie.AktuellerKurs.ToString("0.00") $</td>
                        <td class="@aktie.VeraenderungCssKlasse()">@aktie.KursAenderung()</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}
