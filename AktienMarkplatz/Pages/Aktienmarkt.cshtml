@page
@model AktienMarkplatz.Pages.AktienmarktModel

@{
    ViewData["Title"] = "Aktienmarkt";
}

<section class="suche">
    <h1 class="suche__titel">Welche Aktie interessiert dich?</h1>

    <form method="get" class="suche__form">
        <label for="symbol" class="visually-hidden">Ticker oder Firmenname</label>
        <input id="symbol"
               type="text"
               name="symbol"
               class="suche__eingabe"
               placeholder="Ticker oder Firmenname, z. B. Apple, SAP, ServiceNow"
               value="@Model.Symbol"
               autocomplete="off" />
        <button type="submit" class="suche__button">Suchen</button>
    </form>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Symbol))
{
    <section class="ergebnis" aria-live="polite">
        @if (Model.Antwort is null)
        {
            <p class="ergebnis__leer">
                Keine Aktie gefunden für „@Model.Symbol“. Versuch's mit dem Tickersymbol, z. B. AAPL.
            </p>
        }
        else if (Model.Antwort.Ergebnisse.Count == 0)
        {
            <div class="ergebnis__kopf">
                <span class="ergebnis__ticker">@Model.Symbol.ToUpper()</span>
                <span class="ergebnis__meta">Keine Dividendenhistorie hinterlegt</span>
            </div>
            <p class="ergebnis__leer">Diese Aktie schüttet aktuell keine Dividende aus.</p>
        }
        else
        {
            var erste = Model.Antwort.Ergebnisse[0];

            <div class="ergebnis__kopf">
                <span class="ergebnis__ticker">@erste.Tickersymbol</span>
                <span class="ergebnis__meta">Ergebnisse für „@Model.Symbol“</span>
            </div>

            <table class="tabelle">
                <thead>
                    <tr>
                        <th scope="col">Auszahlung</th>
                        <th scope="col">Ex-Datum</th>
                        <th scope="col">Betrag</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dividende in Model.Antwort.Ergebnisse)
                    {
                        <tr>
                            <td>@dividende.Auszahlungsdatum</td>
                            <td>@dividende.ExDatum</td>
                            <td class="ergebnis__betrag">@dividende.Betrag.ToString("0.00") €</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

<section class="top-aktien">
    <h2>Die größten Aktien</h2>

    <table class="tabelle">
        <thead>
            <tr>
                <th scope="col">Ticker</th>
                <th scope="col">Name</th>
                <th scope="col">Kurs</th>
                <th scope="col">Veränderung</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (aktie, veraenderung) in Model.GroessteAktien)
            {
                var steigt = veraenderung >= 0;
                <tr>
                    <td>@aktie.Symbol</td>
                    <td>@aktie.Name</td>
                    <td>@aktie.AktuellerKurs.ToString("0.00") €</td>
                    <td class="@(steigt ? "veraenderung--gewinn" : "veraenderung--verlust")">
                        @(steigt ? "▲" : "▼") @Math.Abs(veraenderung).ToString("0.0") %
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
