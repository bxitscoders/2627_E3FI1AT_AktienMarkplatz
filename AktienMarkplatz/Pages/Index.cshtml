@page
@model AktienMarkplatz.Pages.IndexModel

<h1>Aktie suchen</h1>

<form method="get">
    <input type="text"
           name="symbol"
           placeholder="z. B. AAPL, MSFT, TSLA"
           value="@Model.Symbol" />

    <button type="submit">Suchen</button>
</form>

@if (Model.ApiAntwort is not null)
{
    <h2>Dividenden für @Model.Symbol</h2>

    @if (Model.ApiAntwort.Results.Count == 0)
    {
        <p>Keine Dividenden gefunden.</p>
    }
    else
    {
        <ul>
            @foreach (var dividend in Model.ApiAntwort.Results)
            {
                <li>
                    @dividend.PayDate — @dividend.CashAmount € (Ex-Datum: @dividend.ExDividendDate)
                </li>
            }
        </ul>
    }
}