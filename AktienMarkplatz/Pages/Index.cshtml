@page
@model AktienMarkplatz.Pages.IndexModel

<h1>Aktie suchen</h1>

<form method="get">
    <input type="text"
           name="symbol"
           placeholder="z. B. AAPL, MSFT, TSLA"
           value="@Model.Symbol" />

    <button type="submit">Suchen</button>
</form>

@if (!string.IsNullOrEmpty(Model.ApiAntwort))
{
    <h2>API Antwort</h2>

    <pre>@Model.ApiAntwort</pre>
}