@page
@model AktienMarkplatz.Pages.IndexModel

<h1>Aktie suchen</h1>

<form method="get">
    <input type="text"
           name="symbol"
           placeholder="z. B. AAPL, MSFT, TSLA"
           value="@Model.Symbol" />

    <button type="submit">Suchen</button>
</form>

@if (Model.Antwort is not null)
{
    <h2>Dividenden für @Model.Symbol</h2>

    @if (Model.Antwort.Ergebnisse.Count == 0)
    {
        <p>Keine Dividenden gefunden.</p>
    }
    else
    {
        <ul>
            @foreach (var dividende in Model.Antwort.Ergebnisse)
            {
                <li>
                    @dividende.Auszahlungsdatum — @dividende.Betrag € (Ex-Datum: @dividende.ExDatum)
                </li>
            }
        </ul>
    }
}